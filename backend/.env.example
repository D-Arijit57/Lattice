SECRET_KEY=change-me-generate-a-new-key-for-each-environment
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/NAME
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Minimum level to log: DEBUG, INFO, WARNING, ERROR (default INFO)
LOG_LEVEL=INFO

# Proxies between the internet and Django (used to find the real client IP for
# rate limiting). 0 locally; set to the real hop count in production.
NUM_PROXIES=0
