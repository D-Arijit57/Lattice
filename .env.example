# Used by docker-compose.yml. Copy to .env and fill in.
# Supabase Session pooler URI (Connect > Session pooler). Percent-encode special
# characters in the password (e.g. @ becomes %40).
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
SECRET_KEY=change-me-generate-a-new-key-for-each-environment

# True = local http testing (cookies are not Secure, no HTTPS redirect).
# Must be False in production.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
NUM_PROXIES=1
