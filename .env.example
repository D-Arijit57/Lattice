# Used by docker-compose.yml. Copy to .env and fill in.
POSTGRES_USER=lattice
POSTGRES_PASSWORD=change-me
SECRET_KEY=change-me-generate-a-new-key-for-each-environment

# True = local http testing (cookies are not Secure, no HTTPS redirect).
# Must be False in production.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
NUM_PROXIES=1
